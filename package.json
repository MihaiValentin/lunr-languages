{
  "name": "lunr-languages",
  "description": "A a collection of languages stemmers and stopwords for Lunr Javascript library",
  "author": "Mihai Valentin (http://www.mihaivalentin.com)",
  "version": "1.24.0",
  "license": "MPL-1.1",
  "files": [
    "lunr.*.js",
    "min/lunr.*.min.js",
    "licenses",
    "types"
  ],
  "type": "commonjs",
  "types": "./types/index.d.ts",
  "typesVersions": {
    "*": {
      "lunr.*.js": [
        "types/plugin.d.ts"
      ],
      "lunr.*": [
        "types/plugin.d.ts"
      ],
      "min/lunr.*.min.js": [
        "types/plugin.d.ts"
      ],
      "min/lunr.*.min": [
        "types/plugin.d.ts"
      ]
    }
  },
  "engines": {
    "node": ">=14.6"
  },
  "peerDependencies": {
    "@node-rs/jieba": "^1.0.0 || ^2.0.0",
    "lunr": "^2.0.0"
  },
  "peerDependenciesMeta": {
    "@node-rs/jieba": {
      "optional": true
    }
  },
  "exports": {
    "./package.json": "./package.json",
    "./lunr.*.js": {
      "types": "./types/plugin.d.ts",
      "import": "./lunr.*.js",
      "require": "./lunr.*.js",
      "default": "./lunr.*.js"
    },
    "./lunr.*": {
      "types": "./types/plugin.d.ts",
      "import": "./lunr.*.js",
      "require": "./lunr.*.js",
      "default": "./lunr.*.js"
    },
    "./min/lunr.*.min.js": {
      "types": "./types/plugin.d.ts",
      "import": "./min/lunr.*.min.js",
      "require": "./min/lunr.*.min.js",
      "default": "./min/lunr.*.min.js"
    },
    "./min/lunr.*.min": {
      "types": "./types/plugin.d.ts",
      "import": "./min/lunr.*.min.js",
      "require": "./min/lunr.*.min.js",
      "default": "./min/lunr.*.min.js"
    },
    "./*": "./*"
  },
  "scripts": {
    "build": "node build/build.js",
    "build-wordcut": "node build/build-wordcut.js",
    "derive-maps": "node build/derive-fold-maps.js",
    "fetch-cldr": "node build/fetch-cldr.js",
    "fetch-data": "node build/fetch-snowball.js && node build/fetch-cldr.js && node build/derive-fold-maps.js",
    "fetch-snowball": "node build/fetch-snowball.js",
    "test": "node --test test/*Test.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MihaiValentin/lunr-languages"
  },
  "devDependencies": {
    "acorn": "^8.19.0",
    "js-beautify": "^2.0.3",
    "typescript": "5.6.3",
    "uglify-js": "^3.19.3",
    "unicode-8.0.0": "^0.1.5"
  }
}
